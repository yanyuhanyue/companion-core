{
  "core_url": {
    "description": "Companion 内部地址",
    "type": "string",
    "default": "http://companion-api:8765"
  },
  "owner_qq_id": {
    "description": "主人 QQ",
    "type": "string",
    "default": ""
  },
  "bot_qq_id": {
    "description": "机器人 QQ",
    "type": "string",
    "default": ""
  },
  "bridge_token": {
    "description": "内部 API 令牌",
    "type": "string",
    "secret": true,
    "default": ""
  },
  "protocol_backend": {
    "description": "旧 spool 协议后端，核对期间须与原部署一致",
    "type": "string",
    "options": [
      "napcat",
      "snowluma"
    ],
    "default": "napcat"
  },
  "protocol_epoch": {
    "description": "旧接入批次号，核对期间保持原值",
    "type": "string",
    "default": ""
  },
  "drain_existing": {
    "type": "bool",
    "description": "仅核对旧队列和已有投递回执；新主人消息由原生 Bridge 接收",
    "default": false
  }
}
