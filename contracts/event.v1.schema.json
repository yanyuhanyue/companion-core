{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/companion/contracts/event.v1.schema.json",
  "title": "Companion Inbound Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "source", "source_event_id", "event_type", "occurred_at", "conversation", "actor", "payload", "trace_id"],
  "$defs": {
    "referenceBody": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source", "nodes", "issues"],
      "properties": {
        "status": {"enum": ["READ", "PARTIAL", "MISSING", "UNSUPPORTED", "TRUNCATED"]},
        "source": {"enum": ["INLINE", "ONEBOT"]},
        "issues": {
          "type": "array", "uniqueItems": true, "maxItems": 13,
          "items": {"enum": ["FETCH_FAILED", "TIMEOUT", "PLACEHOLDER", "NO_TEXT", "UNSUPPORTED_MEDIA", "DEPTH_LIMIT", "NODE_LIMIT", "CHAR_LIMIT", "FETCH_LIMIT", "CYCLE", "MALFORMED", "SIZE_LIMIT"]}
        },
        "nodes": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "nickname", "text"],
            "properties": {
              "path": {"type": "array", "maxItems": 8, "items": {"type": "integer", "minimum": 0, "maximum": 63}},
              "nickname": {"type": "string", "maxLength": 128},
              "text": {"type": "string", "minLength": 1, "maxLength": 6000}
            }
          }
        }
      }
    },
    "richSegment": {
      "type": "object",
      "required": ["index", "type", "actor", "coverage"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 63},
        "actor": {"const": "UNVERIFIED"}
      },
      "oneOf": [
        {
          "properties": {
            "type": {"const": "reply"}, "coverage": {"const": "MISSING"},
            "reference": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,19})$"},
            "body": {"$ref": "#/$defs/referenceBody"}
          },
          "required": ["reference"]
        },
        {
          "properties": {
            "type": {"const": "forward"}, "coverage": {"const": "UNFETCHED"},
            "reference": {"type": "string", "pattern": "^[A-Za-z0-9_+/=-]{1,256}$"},
            "body": {"$ref": "#/$defs/referenceBody"}
          },
          "required": ["reference"]
        },
        {
          "properties": {
            "type": {"const": "node"}, "coverage": {"const": "UNSUPPORTED"},
            "body": {"$ref": "#/$defs/referenceBody"}
          }
        },
        {
          "properties": {
            "type": {"const": "json"}, "coverage": {"enum": ["PARTIAL", "UNSUPPORTED"]},
            "fields": {
              "type": "array", "maxItems": 22,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["path", "kind", "value"],
                "properties": {
                  "path": {"enum": ["/title", "/desc", "/summary", "/prompt", "/url", "/jumpUrl", "/meta/detail_1/title", "/meta/detail_1/desc", "/meta/detail_1/qqdocurl", "/meta/detail_1/url", "/meta/detail_1/jumpUrl", "/meta/detail/title", "/meta/detail/desc", "/meta/detail/summary", "/meta/detail/url", "/meta/news/title", "/meta/news/desc", "/meta/news/jumpUrl", "/meta/news/url", "/meta/music/title", "/meta/music/desc", "/meta/music/jumpUrl"]},
                  "kind": {"enum": ["title", "summary", "url"]},
                  "value": {"type": "string", "minLength": 1, "maxLength": 2048}
                }
              }
            }
          },
          "required": ["fields"]
        },
        {
          "properties": {
            "type": {"const": "image"}, "coverage": {"const": "UNREAD"},
            "slot": {"type": "integer", "minimum": 0, "maximum": 3},
            "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "required": ["slot", "source_sha256"]
        },
        {"properties": {"type": {"enum": ["image", "record", "video", "file", "other"]}, "coverage": {"const": "UNSUPPORTED"}}}
      ],
      "unevaluatedProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 8},
    "source": {"const": "qq.onebot"},
    "source_event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["message.received", "message.media_received"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 8},
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_session_key", "scope"],
      "properties": {
        "platform_session_key": {"type": "string", "minLength": 1},
        "scope": {"const": "private"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_user_id", "role"],
      "properties": {
        "platform_user_id": {"type": "string", "minLength": 1},
        "role": {"const": "owner"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "media"],
      "properties": {
        "text": {"type": "string", "maxLength": 20000},
        "rich": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "coverage", "segments", "segment_count", "owner_text_positions"],
          "properties": {
            "version": {"const": "references_v1"},
            "coverage": {"const": "PARTIAL"},
            "segments": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/richSegment"}},
            "segment_count": {"type": "integer", "minimum": 1, "maximum": 64},
            "owner_text_positions": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 63}}
          }
        },
        "shared_content": {
          "type": "array", "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "url"],
                "properties": {
                  "kind": {"const": "link"},
                  "url": {"type": "string", "minLength": 1, "maxLength": 2048}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "slot"],
                "properties": {
                  "kind": {"const": "image"},
                  "slot": {"type": "integer", "minimum": 0, "maximum": 3}
                }
              }
            ]
          }
        },
        "media": {
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "media_ref", "sha256"],
            "properties": {
              "kind": {"enum": ["image", "file", "voice"]},
              "media_ref": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
