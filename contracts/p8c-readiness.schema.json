            "core_enabled": {"const":false},
            "screenshot_connected": {"const":false},
            "keyboard_mouse_connected": {"const":false},
            "app_launch_connected": {"const":false},
            "desktop_e2e_p50_ms": {"type":"null"},
            "desktop_e2e_p95_ms": {"type":"null"}
          }
        }
      }
    },
