{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion.invalid/contracts/p8c-readiness.schema.json",
  "title": "P8-C offline readiness template, never runtime authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "evidence_level",
    "authority",
    "snapshot",
    "environment",
    "requests",
    "runtime",
    "actions",
    "validation"
  ],
  "properties": {
    "$schema": {"const":"../../contracts/p8c-readiness.schema.json"},
    "schema_version": {"const":1},
    "evidence_level": {"const":"OFFLINE_PROPOSAL"},
    "authority": {"const":"Preparation only; six separately signed private approvals are required. This JSON is not a runtime approval."},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "main_sha",
        "main_ci",
        "reviewed_source_sha",
        "candidate_sha",
        "integration_pr",
        "original_prs",
        "source_contracts",
        "integrated_candidate_sha",
        "integrated_tree",
        "code_migration_head",
        "independent_review"
      ],
      "properties": {
        "observed_at": {"type":"string","format":"date-time"},
        "main_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "main_ci": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_url",
            "status",
            "conclusion",
            "successful_jobs",
            "jobs"
          ],
          "properties": {
            "run_url": {"type":"string","pattern":"^https://github[.]com/yanyuhanyue/companion-core/"},
            "status": {"enum":["completed","in_progress","queued"]},
            "conclusion": {"enum":["success","failure","cancelled","skipped",null]},
            "successful_jobs": {"type":"integer","minimum":0},
            "jobs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "conclusion",
                  "url"
                ],
                "properties": {
                  "name": {"type":"string","minLength":1},
                  "conclusion": {"enum":["success","failure","cancelled","skipped"]},
                  "url": {"type":"string","pattern":"^https://github[.]com/yanyuhanyue/companion-core/"}
                }
              }
            }
          }
        },
        "reviewed_source_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "candidate_sha": {"$ref":"#/$defs/commit"},
        "integration_pr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "state",
            "head_sha",
            "ci_status",
            "run_urls",
            "merged_sha"
          ],
          "properties": {
            "url": {"type":"string","pattern":"^https://github[.]com/yanyuhanyue/companion-core/"},
            "state": {"enum":["OPEN","CLOSED","MERGED"]},
            "head_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "ci_status": {"type":"string","minLength":1},
            "run_urls": {
              "type": "array",
              "minItems": 1,
              "items": {"type":"string","pattern":"^https://github[.]com/yanyuhanyue/companion-core/"}
            },
            "merged_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "original_prs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "head_sha",
              "state",
              "draft_at_source"
            ],
            "properties": {
              "number": {"enum":[24,25,26,27]},
              "head_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "state": {"enum":["OPEN","CLOSED","MERGED"]},
              "draft_at_source": {"type":"boolean"}
            }
          }
        },
        "source_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha",
              "evidence"
            ],
            "properties": {
              "path": {"type":"string","minLength":1},
              "sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "evidence": {"const":"CODE_ONLY"}
            }
          }
        },
        "integrated_candidate_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "integrated_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "code_migration_head": {
          "type": "string",
          "pattern": "^[0-9]{4}_[a-z0-9_]+$"
        },
        "independent_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reviewed_sha",
            "reported_findings",
            "done",
            "reference",
            "conclusion",
            "report_commit",
            "report_url",
            "coverage_limits"
          ],
          "properties": {
            "state": {"enum":["IN_PROGRESS","COMPLETED","FINDINGS_OPEN"]},
            "reviewed_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "reported_findings": {
              "type": "array",
              "items": {}
            },
            "done": {"type":"boolean"},
            "reference": {"type":"string","minLength":1},
            "conclusion": {"type":["string","null"]},
            "report_commit": {"$ref":"#/$defs/commit"},
            "report_url": {"$ref":"#/$defs/text"},
            "coverage_limits": {
              "type": "array",
              "items": {"type":"string","minLength":1}
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_test_host",
