            "keyboard_mouse_connected",
            "app_launch_connected",
            "desktop_e2e_p50_ms",
            "desktop_e2e_p95_ms"
          ],
          "properties": {
            "evidence": {"const":"USER_SUPPLIED_NOT_PROBED"},
            "private_link": {"const":"TAILSCALE_CONFIGURED"},
            "connected_executor_methods": {
              "type": "array",
              "items": {},
